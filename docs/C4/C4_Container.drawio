                <object placeholders="1" c4Name="Enricher Module" c4Type="Container" c4Technology="OpenMRS module (Java)" c4Description="Verrijkt/normaliseert OpenMRS events en stuurt ze via HTTP webhook naar de Notification API. RabbitMQ is niet bereikbaar van buitenaf." label="&lt;font style=&quot;font-size: 13px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;%c4Description%&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" id="openmrs-enricher">
