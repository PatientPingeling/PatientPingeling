                <mxCell id="notes" value="Containers:&lt;br&gt;- Notification API: ontvangt webhook, schrijft atomisch naar DB.&lt;br&gt;- Scheduler: pollt scheduled_notifications, publiceert naar RabbitMQ.&lt;br&gt;- Notification Worker: consumeert queue, stuurt via provider adapter + Polly.&lt;br&gt;&lt;br&gt;ADR-koppeling:&lt;br&gt;- ADR1: module staat los van OpenMRS.&lt;br&gt;- ADR2: C#/.NET, PostgreSQL, RabbitMQ, Grafana.&lt;br&gt;- ADR6: integratie via HTTP webhook (veilige systeemgrens).&lt;br&gt;- ADR4: RabbitMQ als interne queue-infrastructuur.&lt;br&gt;- ADR6: Enricher stuurt webhook naar Notification API." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F9FAFB;strokeColor=#D1D5DB;fontColor=#374151;fontSize=11;align=left;verticalAlign=top;spacing=10;" parent="1" vertex="1">
                    <mxGeometry x="60" y="770" width="340" height="200" as="geometry"/>
                </mxCell>
                <object placeholders="1" c4Type="Relationship" c4Technology="AMQP" c4Description="Consumeert nieuwe verzendstatus" label="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;br&gt;[%c4Technology%]&lt;/div&gt;" id="5">
                    <mxCell style="endArrow=blockThin;html=1;fontSize=10;fontColor=#404040;strokeWidth=1;endFill=1;strokeColor=#828282;metaEdit=1;endSize=14;startSize=14;rounded=0;edgeStyle=orthogonalEdgeStyle;exitX=0.303;exitY=0.981;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.01;entryY=0.299;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="rabbitmq" target="notification-scheduler">
                        <mxGeometry x="-0.01" y="-58" relative="1" as="geometry">
                            <mxPoint as="offset"/>
                            <mxPoint x="1030" y="583" as="sourcePoint"/>
