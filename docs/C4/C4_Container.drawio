                <mxCell id="subtitle" value="Drie interne containers: Notification API (webhook ontvangst), Scheduler (pollt scheduled_notifications), Notification Worker (verstuurt via providers). RabbitMQ en PostgreSQL als interne infrastructuur." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#4B5563;" parent="1" vertex="1">
                    <mxGeometry x="50" y="62" width="1400" height="30" as="geometry"/>
                </mxCell>
